{
  "name": "pg-completion-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs --release",
    "predev": "node scripts/build-wasm.mjs --release",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-wasm.mjs --release && vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "monaco-editor": "^0.53.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.8"
  }
}
